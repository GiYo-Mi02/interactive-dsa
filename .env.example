# OpenAI API Key for AI explanation and diagnosis features
OPENAI_API_KEY=

# Piston Code Execution API URL
# Note: The default public instance (https://emkc.org/api/v2/piston/execute) is whitelist-only as of Feb 2026.
# If you want to use the sandbox page, please self-host Piston (e.g., using Docker: docker run -d -p 2000:2000 engineer-man/piston)
# and set PISTON_API_URL=http://localhost:2000/api/v2/piston/execute
PISTON_API_URL=https://emkc.org/api/v2/piston/execute
